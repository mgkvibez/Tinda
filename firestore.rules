rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can read all users, but only write their own
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Jobs collection - employers can create jobs, candidates can read
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Swipes collection - users can only read/write their own swipes
    match /swipes/{swipeId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Profiles collection - users can read all, write their own
    match /profiles/{profileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == profileId;
    }

    // Matches collection - users can read their own matches
    match /matches/{matchId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.candidateId || request.auth.uid == resource.data.employerId);
      allow create: if request.auth != null && 
        (request.auth.uid == request.resource.data.candidateId || request.auth.uid == request.resource.data.employerId);
    }

    // Catch-all rule for any other collections - authenticated users can read, owners can write
    match /{document=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}